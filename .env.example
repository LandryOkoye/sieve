POSTGRES_DB=sieve
POSTGRES_USER=sieve
POSTGRES_PASSWORD=sieve_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sieve:sieve_local_only@127.0.0.1:5432/sieve
# Optional Sui chain lookup. Defaults to testnet.
# TATUM_API_KEY=
# TATUM_NETWORK=testnet
# Optional Walrus Memory delegate. Namespace defaults to sieve-threat-memory.
# MEMWAL_ACCOUNT_ID=
# MEMWAL_PRIVATE_KEY=
# MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz
# MEMWAL_NAMESPACE=sieve-threat-memory
# Optional semantic judge. Configure both values together to enable it.
# OPENAI_API_KEY is managed in the local shell or secret store; do not commit it.
# OPENAI_MODEL=

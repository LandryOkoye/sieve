# Public OIDC SPA configuration. Never place a client secret in VITE_* variables.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# Optional when the API is not available through Vite's local /api proxy.
# VITE_API_BASE_URL=http://localhost:3001
